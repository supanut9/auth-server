APP_NAME=auth-server
APP_ENV=development
HTTP_ADDR=:8050
PUBLIC_BASE_URL=http://localhost:8050
AUTH_UI_BASE_URL=http://localhost:3005
POST_LOGOUT_REDIRECT_ALLOWLIST=http://localhost:3006,http://localhost:3007,http://localhost:3008

DATABASE_URL=postgres://postgres:postgres@localhost:55432/auth_server?sslmode=disable
# Optional in the current runtime. Keep set when you want parity with the planned stack.
REDIS_URL=redis://localhost:56379/0

JWT_ISSUER=http://localhost:8050
JWT_SIGNING_ALG=RS256
JWT_PRIVATE_KEY_PATH=./secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt-public.pem
# Optional Vercel-style secret source. Set these instead of the *_PATH values when file mounts are unavailable.
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
PLATFORM_AUDIENCE=platform-api
ACCESS_TOKEN_TTL=10m
ID_TOKEN_TTL=10m
REFRESH_TOKEN_ABSOLUTE_TTL=720h
REFRESH_TOKEN_INACTIVE_TTL=168h
# Grace window in which a just-rotated refresh token may be replayed by
# concurrent client requests without tripping reuse-detection. Reuse after this
# window still revokes the chain.
REFRESH_TOKEN_REUSE_GRACE=60s
OTP_CHALLENGE_TTL=10m
AUTHORIZATION_REQUEST_TTL=10m
AUTHORIZATION_CODE_TTL=5m
SSO_SESSION_TTL=720h
SSO_COOKIE_SECURE=false
SSO_COOKIE_SAME_SITE=lax
SSO_COOKIE_DOMAIN=
OTP_MAX_ATTEMPTS=6
OTP_MAX_RESENDS=3
OTP_RESEND_COOLDOWN=1m

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8050/v1/auth/login/callback/google

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=http://localhost:8050/v1/auth/login/callback/github

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
FIXED_OTP_CODE=

SUPPORT_API_TOKEN=dev-support-token
