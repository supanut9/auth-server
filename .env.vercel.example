APP_NAME=auth-server
APP_ENV=production
HTTP_ADDR=:3000
PUBLIC_BASE_URL=https://auth.example.com
AUTH_UI_BASE_URL=https://auth-ui.example.com
POST_LOGOUT_REDIRECT_ALLOWLIST=https://auth-ui.example.com,https://language.example.com

DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require

JWT_ISSUER=https://auth.example.com
JWT_SIGNING_ALG=RS256
JWT_PRIVATE_KEY_PEM=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
JWT_PUBLIC_KEY_PEM=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
PLATFORM_AUDIENCE=platform-api
ACCESS_TOKEN_TTL=10m
ID_TOKEN_TTL=10m
REFRESH_TOKEN_ABSOLUTE_TTL=720h
REFRESH_TOKEN_INACTIVE_TTL=168h
OTP_CHALLENGE_TTL=10m
AUTHORIZATION_REQUEST_TTL=10m
AUTHORIZATION_CODE_TTL=5m
SSO_SESSION_TTL=720h
SSO_COOKIE_SECURE=true
SSO_COOKIE_SAME_SITE=none
SSO_COOKIE_DOMAIN=.example.com
OTP_MAX_ATTEMPTS=6
OTP_MAX_RESENDS=3
OTP_RESEND_COOLDOWN=1m

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://auth.example.com/v1/auth/login/callback/google

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=https://auth.example.com/v1/auth/login/callback/github

# Resend SMTP relay — https://resend.com/settings/smtp
# 1. Sign up for a free Resend account.
# 2. Verify your sending domain under Resend → Domains.
# 3. Create an API key under Resend → API Keys (full or sending-only scope).
# 4. Set SMTP_PASSWORD to that API key.
# 5. Set SMTP_FROM to an address on your verified domain.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=<resend-api-key>
SMTP_FROM=noreply@yourdomain.com

SUPPORT_API_TOKEN=replace-with-random-secret

# Non-production only: comma-separated list of email addresses that may use
# GET /v1/auth/otp/test-hint for CI automation. MUST NOT be set in production.
# Leave unset (or empty) to disable the endpoint entirely.
# Pair with FIXED_OTP_CODE so CI knows the code in advance.
# Example: OTP_TEST_HINT_ALLOWLIST=ci-smoke@yourdomain.com
OTP_TEST_HINT_ALLOWLIST=

# Optional client-seed overrides for deployed URLs.
DEV_BROWSER_REDIRECT_URIS=https://auth.example.com/dev/callback
COMMUNITY_WEB_REDIRECT_URIS=https://community.example.com/api/auth/oauth2/callback/auth-server
KNOWLEDGE_WEB_REDIRECT_URIS=https://knowledge.example.com/api/auth/oauth2/callback/auth-server
LANGUAGE_WEB_REDIRECT_URIS=https://language.example.com/api/auth/oauth2/callback/auth-server
COMMUNITY_WEB_CLIENT_SECRET=community-web-secret
KNOWLEDGE_WEB_CLIENT_SECRET=knowledge-web-secret
LANGUAGE_WEB_CLIENT_SECRET=language-web-secret
DEV_WORKER_CLIENT_SECRET=dev-worker-secret
REALTIME_SERVICE_CLIENT_SECRET=dev-realtime-secret
