  "token_normalize_scopes": {
    "cases": [
      {
        "input": null,
        "output": [],
        "joined": ""
      },
      {
        "input": [
          "openid",
          "profile",
          "email"
        ],
        "output": [
          "email",
          "openid",
          "profile"
        ],
        "joined": "email openid profile"
      },
      {
        "input": [
          " openid ",
          "openid",
          "",
          "  "
        ],
        "output": [
          "openid"
        ],
        "joined": "openid"
      },
      {
        "input": [
          "trading.write",
          "Trading.read",
          "trading.read",
          "a,b"
        ],
        "output": [
          "Trading.read",
          "a,b",
          "trading.read",
          "trading.write"
        ],
        "joined": "Trading.read a,b trading.read trading.write"
      },
      {
        "input": [
          "z",
          "Z",
          "é",
          "e",
          "_",
          "1"
        ],
        "output": [
          "1",
          "Z",
          "_",
          "e",
          "z",
          "é"
        ],
        "joined": "1 Z _ e z é"
      }
    ],
    "description": "token/service.go normalizeScopes: applied to every requested scope list before signing (user + client_credentials). Trim each, drop empty, dedupe, sort.Strings (byte-wise). Empty input -> [] and joined \"\"."
  },
